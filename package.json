{
  "name": "q-browser-demo",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4177 --strictPort",
    "build": "tsc -b && vite build",
    "build:pages": "VITE_BASE_PATH=/q-browser/ pnpm run build",
    "preview": "vite preview --host 127.0.0.1 --port 4177 --strictPort",
    "preview:pages": "VITE_BASE_PATH=/q-browser/ pnpm run preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:built": "Q_E2E_BUILT=1 playwright test",
    "test:e2e:pages": "VITE_BASE_PATH=/q-browser/ Q_E2E_BUILT=1 playwright test",
    "check": "tsc -b --pretty false && vitest run"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
